[Unit]
Description=TrustTunnel Web Configuration & Camouflage Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/trusttunnel-panel
ExecStart=/usr/bin/env python3 /opt/trusttunnel-panel/panel/server.py --host 0.0.0.0 --port 8880 --camouflage-port 8080
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
